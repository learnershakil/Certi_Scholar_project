# ==============================================================================
# CertiScholar Environment Configuration Template
# All secrets must remain in .env and NEVER committed to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------------------
# 1. Mandatory Next.js BFF <-> Node.js API Service Key (x-http-key)
# Must be identical in Web BFF and Node API environments. Server-only.
# NEVER expose with NEXT_PUBLIC_ or send to browser client.
# ------------------------------------------------------------------------------
NODE_API_HTTP_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# Node API URL (used by Next.js BFF server route handlers)
NODE_API_BASE_URL=http://localhost:4000

# Web Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database & Cache
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/certischolar
MONGODB_PORT=27017
MONGODB_DATABASE=certischolar

REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. Authentication & JWT / Sessions
# ------------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d
OTP_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# ------------------------------------------------------------------------------
# 4. Storage: Cloudflare R2 (S3-compatible) & Local Storage Fallback
# When R2 credentials are blank or STORAGE_DRIVER=local, local disk is used.
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage/documents

R2_ACCOUNT_ID=placeholder_r2_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_key
R2_BUCKET_NAME=certischolar-documents
R2_PUBLIC_DOMAIN=
R2_ENDPOINT=https://placeholder_r2_account_id.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# 5. Document Intake & Scanning (M1)
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_BYTES=10485760 # 10MB
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png
SCANNER_TYPE=clamav # 'clamav' | 'mock'
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ------------------------------------------------------------------------------
# 6. OCR Service (M2)
# ------------------------------------------------------------------------------
OCR_SERVICE_URL=http://localhost:8000
OCR_SERVICE_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# ------------------------------------------------------------------------------
# 7. Classification: Google Gemini API (M3)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 8. External Verification Providers (M7)
# ------------------------------------------------------------------------------
# DigiLocker Partner API (requires official partner onboarding)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/bff/v1/verification/digilocker/callback
DIGILOCKER_ENABLED=false

# Demo / Simulated Provider (STRICTLY BLOCKED IN PRODUCTION)
ENABLE_SIMULATED_PROVIDER=true

# ------------------------------------------------------------------------------
# 9. Notification & Messaging (Email & WhatsApp OTP)
# ------------------------------------------------------------------------------
NOTIFICATION_PROVIDER=mock # 'smtp' | 'twilio' | 'mock'
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@certischolar.edu

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
